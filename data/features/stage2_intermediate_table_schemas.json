{
  "schema_version": 1,
  "input_candidates": [
    "data/processed/user_behavior_clean.parquet",
    "data/processed/user_behavior_clean.csv"
  ],
  "required_input_columns": [
    "time",
    "user_id",
    "item_id",
    "category_id",
    "behavior_type",
    "behavior_name",
    "behavior_date",
    "behavior_hour",
    "weekday"
  ],
  "feature_window": {
    "observation_start": "2025-11-18 00:00:00",
    "observation_end": "2025-12-18 23:00:00",
    "recency_reference_time": "2025-12-19 00:00:00",
    "time_granularity": "hour",
    "timezone": "naive/source time",
    "boundary_rule": "closed interval: start <= time <= end"
  },
  "behavior_mapping": {
    "1": "pv",
    "2": "fav",
    "3": "cart",
    "4": "buy"
  },
  "conversion_rate_rules": {
    "fav_to_pv_rate": "fav_count / pv_count",
    "cart_to_pv_rate": "cart_count / pv_count",
    "buy_to_pv_rate": "buy_count / pv_count",
    "zero_denominator": 0.0,
    "rounding": "retain full precision during calculation; round only for display"
  },
  "tables": [
    {
      "table_name": "user_features",
      "output_path": "data/features/user_features.parquet",
      "grain": "one row per user_id",
      "primary_key": [
        "user_id"
      ],
      "description": "User activity, diversity, recency, and conversion features.",
      "fields": [
        {
          "table_name": "user_features",
          "feature_name": "user_id",
          "data_type": "int64",
          "description": "User identifier.",
          "calculation": "grouping key: user_id",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": false,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_total_count",
          "data_type": "int64",
          "description": "All user behaviors.",
          "calculation": "count(*)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_pv_count",
          "data_type": "int64",
          "description": "User page-view count.",
          "calculation": "sum(behavior_name = 'pv')",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_fav_count",
          "data_type": "int64",
          "description": "User favorite count.",
          "calculation": "sum(behavior_name = 'fav')",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_cart_count",
          "data_type": "int64",
          "description": "User add-to-cart count.",
          "calculation": "sum(behavior_name = 'cart')",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_buy_count",
          "data_type": "int64",
          "description": "User purchase count.",
          "calculation": "sum(behavior_name = 'buy')",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_unique_item_count",
          "data_type": "int64",
          "description": "Distinct items interacted with by the user.",
          "calculation": "nunique(item_id)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_unique_category_count",
          "data_type": "int64",
          "description": "Distinct categories interacted with by the user.",
          "calculation": "nunique(category_id)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_active_day_count",
          "data_type": "int32",
          "description": "Distinct active dates for the user.",
          "calculation": "nunique(behavior_date)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_first_behavior_time",
          "data_type": "datetime64[ns]",
          "description": "First observed behavior time.",
          "calculation": "min(time)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": false,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_last_behavior_time",
          "data_type": "datetime64[ns]",
          "description": "Last observed behavior time.",
          "calculation": "max(time)",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": false,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_recency_hours",
          "data_type": "float64",
          "description": "Hours from the last behavior to the shared reference time.",
          "calculation": "hours(recency_reference_time - max(time))",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_fav_to_pv_rate",
          "data_type": "float64",
          "description": "Favorites per page view.",
          "calculation": "user_fav_count / user_pv_count; 0 when denominator is 0",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_cart_to_pv_rate",
          "data_type": "float64",
          "description": "Add-to-cart actions per page view.",
          "calculation": "user_cart_count / user_pv_count; 0 when denominator is 0",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_buy_to_pv_rate",
          "data_type": "float64",
          "description": "Purchases per page view.",
          "calculation": "user_buy_count / user_pv_count; 0 when denominator is 0",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_is_buyer",
          "data_type": "uint8",
          "description": "Whether the user has at least one purchase.",
          "calculation": "1 if user_buy_count >= 1 else 0",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        },
        {
          "table_name": "user_features",
          "feature_name": "user_is_repeat_buyer",
          "data_type": "uint8",
          "description": "Whether the user has at least two purchase records.",
          "calculation": "1 if user_buy_count >= 2 else 0",
          "data_source": "data/processed/user_behavior_clean.parquet (CSV fallback)",
          "granularity": "user",
          "used_for_modeling": true,
          "nullable": false
        }
      ]
    },
